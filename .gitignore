# ─── 无头浏览器 / CDP 调试残留 ───────────────────────────────
_cdp_profile*/
.cdp_profile_tec/
_cdp*.cjs
_cdp*.html
# 「改前」对照页：用 _cdp_condbadge.cjs 的 CB_FILE 跑同一套真机动作取证（脚本自己生成，不是源码）
_cb_*.html
connect-cdp.*
cdp-*.log

# ─── 一次性补丁与生成脚本 ───────────────────────────────────
_*.py
_patch_*.py
_mk_*.py
_mk_*.cjs
_probe_*.cjs
_sync_tpl.py
_verify_dbg.js
_dump.html
_geo.html
# 重构期间的一次性产物（注意：不要写 _*.html —— 会误吞要提交的 _template.html）
_index.ref.html
_gamedata.json
_*.woff2

# ─── 截图 / 测试页 / 预览页 ─────────────────────────────────
shot-*.png
_shot-*.png
_spot*.png
# 「以 _ 开头即临时物」的约定在 png 上可以安全地写成通配
# （只在 html 上不能写 `_*.html`，会误吞要提交的 _template.html）
_*.png
screenshot-*
case-*-check.png
index-*
check-*.html
_flash-*.png
_flash-*.html
_crop-*.png
frm-*.png
cert-avatar-demo.*
avatar.b64
avatar_b64.txt

