; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="T.E.C-OS"
config/description="节点图侦探游戏 · Godot 移植（P0 垂直切片）"
run/main_scene="res://scenes/Desktop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
; 不缩放。点阵字体（VonwaonBitmap 12px）只在 12 的整数倍像素落得下原字格，
; canvas_items 会把整张 1280×720 画布重采样到窗口大小 —— 1920×1080 上就是 1.44x，
; 字全部发胖发糊。改成 disabled 后逻辑尺寸 = 窗口像素，界面靠 Desktop._layout_root() 自适应。
window/stretch/mode="disabled"

[editor_plugins]

enabled=PackedStringArray("res://addons/case_nodes/plugin.cfg")

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.914, 0.898, 0.839, 1)
