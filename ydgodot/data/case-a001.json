  "chars": {
    "CHARS_JS": {
      "role": "植物学家",
      "fate": "存活",
      "relation": "抑制素研究的参与者",
      "debut": "SCENES_0602",
      "name": "槿杉",
      "desc": "在植物领域颇有造诣的年轻植物学家。",
      "talkQueue": [],
      "reactions": {
        "CLUES_yzs": {
          "text": "抑制素是我和陆一直在寻找的解决方案的最后一块拼图。这种来自古代文献的方案，或者可以称之为黑魔法。它包含了两道必须执行的步骤：提取物质和献祭生命。在获得抑制素之前，我们一直没有提取到合适的物质以对抗呋喃香豆素。而为了得到这种抑制素，我们反复实验，不断往自己的身体里注射呋喃香豆素，以期望能够得到答案……"
        },
        "DATA_H_music": {
          "text": "我不太懂音乐，大部分时间我都希望花园能够保持安静，不过朱穗似乎很喜欢这首古典乐。"
        },
        "CLUES_wmhj": {
          "text": "辛苦了，陆。"
        }
      },
      "sceneTalks": {
        "SCENES_0602": [
          {
            "text": "“快要成功了，再试试吧。”"
          },
          {
            "text": "“缺少的抑制素，这次有头绪了。”"
          }
        ]
      },
      "hiddenClue": {
        "text": "获得线索：植物学家槿杉",
        "ids": [
          "CLUES_JS"
        ]
      },
      "avatar": "res://assets/raw/jin.png"
    },
