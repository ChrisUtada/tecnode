[resource]
script = ExtResource("5_8d635")
id = "END_xjbh"
name = "献祭与捕获"
recipe = Array[ExtResource("2_xcfsw")]([ExtResource("3_r4nfq"), ExtResource("4_i4j6i")])
message = "傅柏的自述：我只是无意之间提到，一种类似黑魔法的方式或许能够治愈槿杉的奇怪疾病，没想到两人都表现出极其浓厚的兴趣。于是我不得不将这种古老而邪恶的方式告诉了陆和槿，两人很快将其付诸实践。概括而言，就是献祭和捕获，献祭某些珍贵的东西，以捕获某些等价的事物，但别忘记了，世界上并无绝对的公平可言，古老的方式，总是伴随着未知的风险。代价往往大于所得。而人类一旦发现所得的事物正是自己梦寐以求的，很容易便会陷入偏执，完全忽视代价，等在前方的或许只有悲剧。真有趣。"
