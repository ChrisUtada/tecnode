[sub_resource type="Resource" id="Resource_5y5ds"]
script = ExtResource("10_ep07k")
value = "借着光翻开手写植物笔记：大丽花、洋金花、大豕草、石蒜……全是与植物有关的记录。在笔记的最下面，还压着一张A4大小的纸。"
items = Array[ExtResource("2_kuvrc")]([ExtResource("3_4qea2"), ExtResource("4_fmts2"), ExtResource("5_tkq6a"), ExtResource("6_gb2ic"), ExtResource("7_2kb6q")])
label = "翻阅手写笔记"
requires_lit = Array[ExtResource("2_kuvrc")]([ExtResource("8_70cav"), ExtResource("9_wf3cb")])
fail_message = "光线太暗，纸页上的字迹一片模糊。也许该点亮台灯，或者打开手电筒。"

[resource]
script = ExtResource("2_kuvrc")
id = "ITEM_sxbj"
label = "手写笔记"
desc = "各式各样的手写植物笔记，堆满了书桌。纸页上密密麻麻写着植物的名字与习性；光线不足时，字迹便隐进昏暗里。"
commands = Array[ExtResource("1_pichl")]([SubResource("Resource_5y5ds")])
