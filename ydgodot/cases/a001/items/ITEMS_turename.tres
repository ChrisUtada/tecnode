[resource]
script = ExtResource("3_y2tra")
id = "ITEMS_turename"
label = "真名"
desc = "导致区域发生异动的特殊存在的真实身份。异动区域的真名是多个因果链条得以存在的关键因素。真名的捕获需要五感归因。而非真名的结果，组成方式则并不受五感归因限制。把五感线索放到推演桌布后，长按桌布中央的执行者即可开始推演。"
node_items = PackedStringArray()
node_chars = PackedStringArray()
node_locs = PackedStringArray()
node_clues = PackedStringArray()
