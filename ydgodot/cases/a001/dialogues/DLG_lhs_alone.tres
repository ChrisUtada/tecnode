[sub_resource type="Resource" id="Resource_3c823"]
script = ExtResource("4_lf4dw")
text = "陆珩松把录音针挪近了一点，像是怕惊动谁。"

[sub_resource type="Resource" id="Resource_mig5t"]
script = ExtResource("4_lf4dw")
kind = "say"
who = ExtResource("2_3klr4")
text = "如果这段被听见，先记住，我没有把失败算在槿杉头上。"

[sub_resource type="Resource" id="Resource_v5xwq"]
script = ExtResource("4_lf4dw")
kind = "say"
who = ExtResource("2_3klr4")
text = "真正让我停不下来的，是每次都想再多救一个人。"

[sub_resource type="Resource" id="Resource_fxea7"]
script = ExtResource("4_lf4dw")
kind = "say"
who = ExtResource("2_3klr4")
text = "花魄若能留下一线生机，就值得我把这条路走完。"

