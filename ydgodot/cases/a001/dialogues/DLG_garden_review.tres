[sub_resource type="Resource" id="Resource_4b34n"]
script = ExtResource("6_j6prh")
text = "清理残叶时，傅柏注意到朱穗停在一张旧标本前。"

[sub_resource type="Resource" id="Resource_ua3t7"]
script = ExtResource("6_j6prh")
kind = "say"
who = ExtResource("2_40cxa")
text = "这页配比要留档吗？纸边已经发黑了。"

[sub_resource type="Resource" id="Resource_lg2na"]
script = ExtResource("6_j6prh")
kind = "say"
who = ExtResource("4_t8a8n")
text = "先别碰那一页，背面的剂量才是陆师兄反复改的地方。"

[sub_resource type="Resource" id="Resource_tjmmi"]
script = ExtResource("6_j6prh")
kind = "say"
who = ExtResource("3_rbck7")
text = "槿杉，你知道他们已经走到哪一步了，对吗？"

[sub_resource type="Resource" id="Resource_rx7ry"]
script = ExtResource("6_j6prh")
kind = "say"
who = ExtResource("4_t8a8n")
text = "我只知道，再晚一步，花魄就再也拦不回去了。"

[sub_resource type="Resource" id="Resource_0bwyy"]
script = ExtResource("6_j6prh")
kind = "say"
who = ExtResource("2_40cxa")
text = "那我把它单独收好，等你们决定怎么处理。"

[resource]
script = ExtResource("5_xlo6k")
id = "DLG_garden_review"
