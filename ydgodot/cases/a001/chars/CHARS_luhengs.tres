text = "献祭与提取都有极为苛刻的限制和要求。"

[sub_resource type="Resource" id="Resource_q0b34"]
script = ExtResource("16_rauka")
scene = ExtResource("17_323su")
lines = Array[String](["“我请求傅老师再帮我们拍一张合影，但傅老师的脸色一下就变得很难看。”", "“他一言不发，举起了相机。”", "“JS看起来很高兴。”"])

[sub_resource type="Resource" id="Resource_t70wi"]
script = ExtResource("16_rauka")
scene = ExtResource("18_ymv3a")
lines = Array[String](["“这次一定能行了。”", "“只要将抑制剂注入体内，最后的一块拼图也就完成了。”", "“我能让所有人都活下来。”"])

[sub_resource type="Resource" id="Resource_s5xhg"]
