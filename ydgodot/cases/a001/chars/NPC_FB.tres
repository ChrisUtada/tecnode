[sub_resource type="Resource" id="Resource_6a3oj"]
script = ExtResource("6_ao4tr")
scene = ExtResource("2_235sb")
lines = Array[String](["“已经是第三次为他们拍摄合影了。”", "“我总觉得这样的研究不应该再继续下去了。”", "“但槿杉却还是微笑着。”", "“那种痛苦，我无法承受。”", "“有时候我常常跟珩松说，事情被重复十遍的时候，真相就会显现……我希望我是错的。”"])

