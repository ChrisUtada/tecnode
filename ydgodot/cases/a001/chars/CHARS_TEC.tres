scene_talks = Array[ExtResource("5_fr7pr")]([SubResource("Resource_rf7p0"), SubResource("Resource_7q1gj"), SubResource("Resource_iji5q"), SubResource("Resource_1rnt3"), SubResource("Resource_b5lyr"), SubResource("Resource_i76to"), SubResource("Resource_mohrn"), SubResource("Resource_c5m12")])
