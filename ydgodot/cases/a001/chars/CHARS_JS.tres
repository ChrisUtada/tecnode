[sub_resource type="Resource" id="Resource_ysga8"]
script = ExtResource("1_sy1vv")
trigger_id = "CLUES_yzs"
clue = ExtResource("2_qrmrn")
text = "抑制素是我和陆一直在寻找的解决方案的最后一块拼图。这种来自古代文献的方案，或者可以称之为黑魔法。它包含了两道必须执行的步骤：提取物质和献祭生命。在获得抑制素之前，我们一直没有提取到合适的物质以对抗呋喃香豆素。而为了得到这种抑制素，我们反复实验，不断往自己的身体里注射呋喃香豆素，以期望能够得到答案……"

[sub_resource type="Resource" id="Resource_3lunj"]
script = ExtResource("1_sy1vv")
trigger_id = "DATA_H_music"
clue = ExtResource("3_qaao8")
text = "我不太懂音乐，大部分时间我都希望花园能够保持安静，不过朱穗似乎很喜欢这首古典乐。"

[sub_resource type="Resource" id="Resource_xejol"]
