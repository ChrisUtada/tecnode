[resource]
script = ExtResource("1_inpm2")
id = "SCENES_mdhm"
title = "门的后面"
content = "撞击声从厚重的铁门后传来，只有靠得如此之近才能听到。你拉开了铁门，[char:CHARS_zs]惊恐地看着你，一道[item:ITEMS_tzl]挡在你们之间。<br>在离朱穗不远的地上，一个满头白发的人蜷缩着。<br><br>问问[char:CHARS_TEC]"
desc = "撞击声从厚重的铁门后传来，只有靠得如此之近才能听到。你拉开了铁门，朱穗惊恐地看着你，一道铁栅栏挡在你们之间。<br>在离朱穗不远的地上，一个满头白发的人蜷缩着。"
