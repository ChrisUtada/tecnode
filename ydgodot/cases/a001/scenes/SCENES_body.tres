[resource]
script = ExtResource("4_ff8nh")
id = "SCENES_body"
title = "尸体"
content = "黑影被手电筒照亮，出现在眼前的是一具吊死的尸体。<br>死者修长的身体被绑带[item:ITEMS_bd]紧紧缠绕着。头部只露出了紧闭的双眼。<br>[item:ITEMS_xfbyc]流出的血液浸透了绷带。<br>[item:ITEMS_ccss]从屋顶垂下，绕过死者的脖颈，勒出了一条深深的[item:ITEMS_xh]。<br>尸体上散发而出的气味，并非腐臭，而是淡淡的湿青草气味。<br><br>问问[char:CHARS_TEC]<br>返回 [loc:SCENES_garden]"
desc = "一具被吊死的尸体，你上前仔细查看。"
can_be_picked = true
hidden_clue = SubResource("Resource_h2gs8")
