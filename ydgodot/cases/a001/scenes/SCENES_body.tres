[resource]
script = ExtResource("4_ff8nh")
id = "SCENES_body"
title = "尸体"
content = "黑影被手电筒照亮，出现在眼前的是一具吊死的尸体。
死者修长的身体被绑带绷带紧紧缠绕着。头部只露出了紧闭的双眼。
下腹部右侧流出的血液浸透了绷带。
粗糙的绳索从屋顶垂下，绕过死者的脖颈，勒出了一条深深的血痕。
尸体上散发而出的气味，并非腐臭，而是淡淡的湿青草气味。

问问TEC
返回 植物学家的花园"
desc = "一具被吊死的尸体，你上前仔细查看。"
can_be_picked = true
hidden_clue = SubResource("Resource_h2gs8")
node_items = PackedStringArray("ITEMS_bd", "ITEMS_xfbyc", "ITEMS_ccss", "ITEMS_xh")
