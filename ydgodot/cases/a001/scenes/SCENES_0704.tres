[resource]
script = ExtResource("1_a5ggm")
id = "SCENES_0704"
title = "7月4日"
content = "花园之中，G弦的咏叹调反复播放着，[char:CHARS_zs]伏在书桌之上，看起来像是睡着了一般。<br>全身包裹着绷带的[char:CHARS_luhengs]关掉了唱机，手中握着注射器，拖着沉重的脚步，慢慢靠近书桌……<br><br>问问[char:CHARS_TEC]<br>更多[loc:SCENES_fkjl]"
desc = "一个特殊的日子。"
node_items = PackedStringArray()
node_chars = PackedStringArray("CHARS_zs", "CHARS_luhengs")
node_locs = PackedStringArray("SCENES_fkjl")
node_clues = PackedStringArray()
