[sub_resource type="Resource" id="Resource_ejvaa"]
script = ExtResource("2_5gunv")
text = "花园之中，G弦的咏叹调反复播放着。朱穗伏在书桌之上，像是睡着了一般。"

[sub_resource type="Resource" id="Resource_28swq"]
script = ExtResource("2_5gunv")
kind = "say"
who = ExtResource("3_6lp7r")
text = "这次一定能行了。"

[sub_resource type="Resource" id="Resource_q5i4o"]
script = ExtResource("2_5gunv")
kind = "say"
who = ExtResource("3_6lp7r")
text = "只要将抑制剂注入体内，最后的一块拼图也就完成了。"

[sub_resource type="Resource" id="Resource_jr3r0"]
script = ExtResource("2_5gunv")
kind = "say"
who = ExtResource("3_6lp7r")
text = "我能让所有人都活下来。"

[sub_resource type="Resource" id="Resource_kwo4i"]
script = ExtResource("2_5gunv")
text = "他关掉唱机，握紧注射器，拖着沉重的脚步，慢慢靠近书桌。"

[resource]
