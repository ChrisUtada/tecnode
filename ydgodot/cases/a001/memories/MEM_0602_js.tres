[sub_resource type="Resource" id="Resource_sjm74"]
script = ExtResource("2_rrhfx")
text = "那天上午，槿杉在实验室与花园之间来回走了很多趟。她看起来比平时更轻快。"

[sub_resource type="Resource" id="Resource_x0gqd"]
script = ExtResource("2_rrhfx")
kind = "say"
who = ExtResource("3_7rwc4")
text = "快要成功了，再试试吧。"

[sub_resource type="Resource" id="Resource_vqno7"]
script = ExtResource("2_rrhfx")
kind = "say"
who = ExtResource("3_7rwc4")
text = "缺少的抑制素，这次有头绪了。"

[sub_resource type="Resource" id="Resource_05ax7"]
script = ExtResource("2_rrhfx")
text = "她没有告诉任何人，这两句话她已经练习了很久。"

[resource]
script = ExtResource("1_r20ic")
