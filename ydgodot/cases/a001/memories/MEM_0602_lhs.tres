[ext_resource type="Resource" path="res://cases/a001/scenes/SCENES_garden.tres" id="7_u7jh7"]

[sub_resource type="Resource" id="Resource_024ke"]
script = ExtResource("2_frifx")
text = "花园里，槿杉把最后一盆标本摆回架上。傅柏举着相机，迟迟没有按下快门。"

[sub_resource type="Resource" id="Resource_krh0w"]
script = ExtResource("2_frifx")
kind = "say"
who = ExtResource("3_fmyj2")
text = "已经是第三次为他们拍摄合影了。"

[sub_resource type="Resource" id="Resource_jaml6"]
script = ExtResource("2_frifx")
kind = "say"
who = ExtResource("4_wyx08")
text = "我请求傅老师再帮我们拍一张合影，但傅老师的脸色一下就变得很难看。"

[sub_resource type="Resource" id="Resource_cstj5"]
script = ExtResource("2_frifx")
kind = "say"
who = ExtResource("4_wyx08")
text = "他一言不发，举起了相机。"

[sub_resource type="Resource" id="Resource_c83er"]
script = ExtResource("2_frifx")
kind = "say"
who = ExtResource("5_jvuy4")
text = "快要成功了，再试试吧。"

[sub_resource type="Resource" id="Resource_xkece"]
script = ExtResource("2_frifx")
text = "快门落下的那一瞬，槿杉露出了笑容。那是陆珩松后来反复想起的画面。"

[resource]
script = ExtResource("1_5edpk")
