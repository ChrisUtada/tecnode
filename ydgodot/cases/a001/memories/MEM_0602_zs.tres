[sub_resource type="Resource" id="Resource_yupyr"]
script = ExtResource("2_v0dwy")
text = "早上八点，朱穗抱着文件走进花园。灰尘比昨天多一些，她没有在意。"

[sub_resource type="Resource" id="Resource_28o0d"]
script = ExtResource("2_v0dwy")
text = "十点，清洁结束。她关上门，没有回头。"

