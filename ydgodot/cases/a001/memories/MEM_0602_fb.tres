[sub_resource type="Resource" id="Resource_umqkn"]
script = ExtResource("2_72qgq")
text = "每到 6月2日，傅柏都会带着相机来花园。这一天的光线，他记得比谁都清楚。"

[sub_resource type="Resource" id="Resource_rpmgk"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("3_ibfwm")
text = "已经是第三次为他们拍摄合影了。"

[sub_resource type="Resource" id="Resource_yumb1"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("3_ibfwm")
text = "我总觉得这样的研究不应该再继续下去了。"

[sub_resource type="Resource" id="Resource_b6ykp"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("4_su2qa")
text = "缺少的抑制素，这次有头绪了。"

[sub_resource type="Resource" id="Resource_dktw7"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("3_ibfwm")
text = "但槿杉却还是微笑着。"

[sub_resource type="Resource" id="Resource_dh6rl"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("3_ibfwm")
text = "那种痛苦，我无法承受。"

[sub_resource type="Resource" id="Resource_l65nj"]
script = ExtResource("2_72qgq")
kind = "say"
who = ExtResource("3_ibfwm")
text = "有时候我常常跟珩松说，事情被重复十遍的时候，真相就会显现……我希望我是错的。"

